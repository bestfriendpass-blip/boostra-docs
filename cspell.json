{
  "version": "0.2",
  "language": "en,ru",
  "caseSensitive": false,
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]+`/g",
    "/https?:\\/\\/\\S+/g"
  ],
  "ignorePaths": [
    "site/**",
    "node_modules/**",
    ".git/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "ru_ru"],
  "files": ["docs/**/*.md"]
}
